<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <title>San Valentino 💘</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background-color: #0d1117;
      color: #c9d1d9;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .card {
      background-color: #161b22;
      padding: 30px;
      border-radius: 14px;
      text-align: center;
      box-shadow: 0 0 25px rgba(255, 105, 180, 0.25);
      width: 320px;
      position: relative;
    }

    img {
      width: 100%;
      border-radius: 10px;
      margin-bottom: 18px;
    }

    h1 {
      font-size: 22px;
      margin-bottom: 18px;
    }

    button {
      padding: 10px 22px;
      margin: 8px;
      border: none;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
    }

    .yes {
      background-color: #238636;
      color: white;
    }

    .no {
      background-color: #da3633;
      color: white;
      position: relative;
    }

    /* schermata finale nascosta */
    #finale {
      display: none;
    }
  </style>
</head>
<body>

  <!-- SCHERMATA INIZIALE -->
  <div class="card" id="inizio">
    <img src="prima.jpg" alt="foto iniziale">
    <h1>💖 Vuoi essere il mio San Valentino?</h1>
    <button class="yes" onclick="yesClick()">Sì</button>
    <button class="no" onclick="moveNo()">No</button>
  </div>

  <!-- SCHERMATA FINALE -->
  <div class="card" id="finale">
    <img src="dopo.jpg" alt="foto finale">
    <h1>Yeeeeeeeeee 🎉💘</h1>
  </div>

  <script>
    let offsetX = 0;
    let offsetY = 0;

    function moveNo() {
      // spostamento più evidente
      const deltaX = Math.floor(Math.random() * 120) - 60; // -60 → +60
      const deltaY = Math.floor(Math.random() * 90) - 45;  // -45 → +45

      offsetX += deltaX;
      offsetY += deltaY;

      // limiti per non farlo sparire
      offsetX = Math.max(-120, Math.min(120, offsetX));
      offsetY = Math.max(-90, Math.min(90, offsetY));

      const noBtn = document.querySelector(".no");
      noBtn.style.left = offsetX + "px";
      noBtn.style.top = offsetY + "px";
    }

    function yesClick() {
      document.getElementById("inizio").style.display = "none";
      document.getElementById("finale").style.display = "block";
    }
  </script>

</body>
</html>
